def reset_button():
    global pos, player_points, cpu_points
    #pos[0] = x , pos[1] = y
    if pos[0] > resetb.x and pos[0] < resetb.x + resetb.width: #determine if mouse is in button x
        if pos[1] > resetb.y and pos[1] < resetb.y + resetb.height: #determine if mouse is in button y
            if event.type == pygame.MOUSEBUTTONDOWN:
                cpu_points = 0
                player_points = 0

def animate_ball():
        global ballspeed_x, ballspeed_y, cpu_speed,speed_num
        #move objects
        ball.x += ballspeed_x
        ball.y += ballspeed_y
    
        #collide with walls and items
        if ball.bottom >= HEIGHT or ball.top <= 0:
            ballspeed_y *= -1
    
        if ball.left <= 0: 
            point_gain("player")
            
        if ball.right >= WIDTH:
            point_gain("cpu")
            
        #collide with paddles
        if ball.colliderect(player) or ball.colliderect(cpu):
            ballspeed_x *= -1
            ballspeed_x *= 1.09 #speed up ball
            ballspeed_y *= 1.09
            speed_num *= random.choice([1.072,1.08,1.09,])
          
def point_gain(winner):
    global cpu_points, player_points

    if winner == "cpu":
        cpu_points += 1
    
        reset_ball()
    if winner == "player":
        player_points += 1
        
        reset_ball()

def reset_ball():
    global ballspeed_x, ballspeed_y, cpu_speed, speed_num

    ballspeed_x = 6
    ballspeed_y = 6
    ball.x = WIDTH/2 -10
    ball.y = HEIGHT/2
    ballspeed_x *= random.choice ([1,-1])
    ballspeed_y *= random.choice ([1,-1])
    speed_num = 6

def animate_player():
    player.y += player_speed

    if player.top <= 0:
        player.top = 0

    if player.bottom >= HEIGHT:
        player.bottom = HEIGHT

def animate_cpu():
    global cpu_speed, reset_ball, ballspeed_y, cpu_speed,speed_num
    cpu.y += cpu_speed

    if ball.centery <= cpu.centery: #if ball above, paddle go up
            cpu_speed = -1* speed_num

    if ball.centery >= cpu.centery: #if ball below, paddle go down
            
            cpu_speed = speed_num
    
    if cpu.top <= 0:
            cpu.top = 0
    if cpu.bottom >= HEIGHT:
            cpu.bottom = HEIGHT

def draw_pause():
    font = pygame.font.Font(None, 100)
    pygame.draw.rect(surface,(128,128,128 ,170),[0,0,WIDTH,HEIGHT])
    pygame.draw.rect(surface,'dark gray', [200,150,600,50],0,10)
    surface.blit(font.render('Paused: Esc to Resume', True, 'black'), (220,160))
    screen.blit(surface,(0,0))
    
